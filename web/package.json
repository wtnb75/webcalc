{
  "name": "webcalc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9",
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "coi-serviceworker": "^0.1.7",
    "jsdom": "^29.1.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.41",
    "xterm": "npm:@xterm/xterm@^5.5.0",
    "xterm-pty": "^0.9.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "postinstall": "cp node_modules/xterm-pty/workerTools.js public/workerTools.js && cp node_modules/coi-serviceworker/coi-serviceworker.js public/coi-serviceworker.js",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  }
}
